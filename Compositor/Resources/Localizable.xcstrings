    "Soften the copies, more the farther they're pushed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔化图像副本。副本偏移越远，效果越强。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "柔化影象副本。副本偏移越遠，效果越強。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adoucir les copies, plus elles sont poussées loin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weichen Sie die Kopien ab, je weiter sie gedrückt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave las copias, más lejos sean empujadas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーを柔らかくし、それらが押し出しているファーザーが増える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사본을 부드럽게 할수록 더 멀리 밀어 넣는다"
          }
        }
      }
    },
