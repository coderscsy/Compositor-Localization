    "How far a color may be from the picked ones and still be selected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit kann eine Farbe von den ausgewählten sein und trotzdem ausgewählt werden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuán lejos puede ser un color de los elegidos y todavía ser seleccionado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est la distance entre une couleur et les couleurs sélectionnées et toujours sélectionné?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピックアップされたものから色がどの位あるか、まだ選択されるか"
