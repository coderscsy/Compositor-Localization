      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画导出最多支持 %@ 帧，所有帧合计最多 %lld 百万像素，编码数据不超过 512 MiB。请缩小导出尺寸或减少帧数。"
          }
        }
