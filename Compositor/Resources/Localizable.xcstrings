          }
        }
      }
    },
    "How fine the detail it sharpens: small for crisp texture, larger for a punchier look": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制锐化细节的尺度。小半径让纹理更清晰，大半径让锐化感更强。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制銳化細節的尺度。小半徑讓紋理更清晰，大半徑讓銳化感更強。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle finesse le détail qu'il aiguise : petit pour une texture croustillante, plus grand pour un look punchier"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie fein das Detail es schärft: klein für knusprige Textur, größer für einen stanzigeren Look"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuán fino es el detalle que afila: pequeño para texturas nítidas, más grande para un aspecto más punzonable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのように細かい詳細をシャープに: 小さな鮮明なテクスチャ、より大きいパンチルの外観"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그것이 빛나는 세부 사항을 어떻게 정리하는가 : 크리스프 구조에 작은, 더 큰, 더 얇은 모습을 위해"
          }
        }
      }
    },
    "How long each frame shows": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每帧的显示时长"
          }
