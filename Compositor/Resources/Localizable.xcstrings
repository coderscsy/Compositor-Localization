    "Light gathered at each disc's rim, as some lenses draw it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制光线在散景光斑边缘的聚集程度，模拟部分镜头的表现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
