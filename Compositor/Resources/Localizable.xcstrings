    "Drag inside the wheel. Angle sets hue, distance sets saturation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Winkel gibt den Farbton, der Abstand die Sättigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre dentro de la rueda. Angle establece el acecho, la distancia establece saturación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser à l'intérieur de la roue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車輪の中のドラッグ。角度セットのhue、間隔セットの飽和。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바퀴 내부를 끌고, 각도는 구름을 설정하고, 거리에는 만족을 설정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在色轮内拖动。角度控制色相，离中心的距离控制饱和度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在色輪內拖動。角度控制色相，離中心的距離控制飽和度。"
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
