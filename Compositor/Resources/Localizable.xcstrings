    "Pull the mask onto the image's own edges, which recovers hair and fur": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die Maske auf die eigenen Ränder des Bildes, wodurch Haare und Fell wiederhergestellt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire la máscara sobre los bordes propios de la imagen, que recupera el cabello y la piel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez le masque sur les bords de l'image, qui récupère les cheveux et la fourrure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "髪と毛を回復する画像のエッジにマスクを引っ張る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지의 자신의 가장자리에 마스크를 뿌리며, 이는 머리카락과 털을 회복합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将蒙版贴合图像边缘，以恢复头发和毛发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將遮色片貼合影象邊緣，以恢復頭髮和毛髮。"
          }
        }
      }
    },
    "Pulls red and blue fringes apart toward the center to reduce color edging.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieht rote und blaue Fransen in Richtung Mitte auseinander, um die Farbkante zu reduzieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se separan los flecos rojos y azules hacia el centro para reducir el borde de color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire les franges rouges et bleues à l'écart vers le centre pour réduire les rebords de couleur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤と青のフリンジを中心に向かって引き寄せ、色を下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨간색과 파란색은 색상 경계를 줄이기 위해 중앙을 향해 분리됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向中心移动红、蓝通道的边缘以减轻色边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向中心移動紅、藍通道的邊緣以減輕色邊。"
          }
        }
      }
    },
