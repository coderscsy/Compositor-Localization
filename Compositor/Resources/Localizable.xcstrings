    "Positive straightens lines that bow outward (barrel); negative, lines that bow inward (pincushion).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive gerade Linien, die sich nach außen beugen (Fass); negative Linien, die sich nach innen beugen (Pincushion)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Positivo endereza líneas que se inclinan hacia fuera (barrel); negativo, líneas que se inclinan hacia adentro (pincushion)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive redresse les lignes qui s'inclinent vers l'extérieur (barrel); négative, les lignes qui s'inclinent vers l'intérieur (pincoussion)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直角線(バレル)、負、弓の線(ピンキュージョン)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긍정적 인 라인은 외부 (바렐)로 굴러가는 라인을 직선; 부정적 인 라인은 내부로 굴러가는 라인 (pincushion)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值校正向外弯曲的线条（桶形畸变），负值校正向内弯曲的线条（枕形畸变）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正值校正向外彎曲的線條（桶形畸變），負值校正向內彎曲的線條（枕形畸變）。"
          }
        }
      }
    },
    "Positive values tighten the detected mask inward; negative values expand it outward": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive Werte ziehen die erfasste Maske nach innen fest; negative Werte dehnen sie nach außen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores positivos ajustan la máscara detectada hacia adentro; los valores negativos se expanden hacia fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs positives resserrent le masque détecté vers l'intérieur; les valeurs négatives l'étendent vers l'extérieur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肯定的な値が検出されたマスクを内側に締めます。負の値が外側に展開します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긍정적 가치는 발견 된 마스크를 내부로 밀어 넣고, 부정적인 가치는 그것을 외부로 확장합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值向内收缩检测到的蒙版，负值向外扩展"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正值向內收縮檢測到的遮色片，負值向外擴充套件"
          }
        }
      }
    },
