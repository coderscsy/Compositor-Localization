    "A layer with no visible pixels, such as an adjustment layer, isn’t saved as a PNG.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可见像素的图层（例如调整图层）无法导出为 PNG。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可見畫素的圖層（例如調整圖層）無法匯出為 PNG。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un calque sans pixels visibles, comme un calque de réglage, n'est pas enregistré comme PNG."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Schicht ohne sichtbare Pixel, z. B. eine Anpassungsschicht, wird nicht als PNG gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una capa sin píxeles visibles, como una capa de ajuste, no se guarda como un PNG."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調整レイヤーなど、可視ピクセルを持たないレイヤーはPNGとして保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이지 않는 픽셀이 없는 레이어, 예를 들어 조정 레이어는 PNG로 저장되지 않습니다."
          }
        }
      }
    },
    "A little stronger than Version 1. The sliders below still fall well short of the current look.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整强度略高于版本 1，仍明显低于当前版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整強度略高於版本 1，仍明顯低於當前版本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu plus fort que la version 1. Les curseurs ci-dessous sont encore bien en deçà de l'aspect actuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas stärker als Version 1. Die Schieberegler unten liegen immer noch weit hinter dem aktuellen Look zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco más fuerte que la versión 1. Los deslizadores abajo todavía están muy cortos de la apariencia actual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン1よりも少し強くなります。下にあるスライダーは、現在の外観の短い状態に陥ります。"
