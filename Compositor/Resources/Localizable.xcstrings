    "Linear histogram with automatic vertical scaling. Tall spikes may extend beyond the graph; all tones from 0 to 255 remain included.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直方图采用线性标度，纵轴自动缩放。较高的峰值可能超出显示区域，图表仍包含 0 至 255 的所有色调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直方圖採用線性標度，縱軸自動縮放。較高的峰值可能超出顯示區域，圖表仍包含 0 至 255 的所有色調。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Histogramme linéaire avec échelle verticale automatique. Les pics peuvent s'étendre au-delà du graphique; toutes les tons de 0 à 255 restent inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineares Histogramm mit automatischer vertikaler Skalierung; hohe Spitzen können über den Graphen hinausreichen; alle Töne von 0 bis 255 bleiben enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Histograma lineal con escala vertical automática. Los picos de tall pueden extenderse más allá del gráfico; todos los tonos de 0 a 255 permanecen incluidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動縦スケーリング付きリニアヒストグラム。 背の高いスパイクは、グラフを超えて伸びる可能性があります。 0から255までのすべてのトーンが含まれている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 수직 스케일링을 가진 선형 히스토그램. 높은 점수는 차트를 넘어서 확장할 수 있으며 0에서 255까지의 모든 톤은 포함되어 있습니다."
          }
        }
      }
    },
