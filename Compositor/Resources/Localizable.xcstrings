    "Shifts how blue is interpreted.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变蓝原色的色相。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變藍原色的色相。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça change l'interprétation du bleu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt, wie Blau interpretiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cambia cómo se interpreta el azul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青が解釈されるシフト。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파란색이 어떻게 해석되는지 바꾸어 놓습니다."
          }
        }
      }
    },
    "Shifts how green is interpreted.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变绿原色的色相。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變綠原色的色相。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace la façon dont le vert est interprété."
          }
        },
        "de": {
          "stringUnit": {
