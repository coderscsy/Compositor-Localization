    "Move the red and blue apart, for colored fringes on the lines": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分离红色和蓝色通道，为扫描线添加色边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分離紅色和藍色通道，為掃描線新增色邊。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez le rouge et le bleu à part, pour les franges colorées sur les lignes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen Sie das Rot und Blau auseinander, für farbige Fransen auf den Linien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el rojo y azul aparte, para fringes de color en las líneas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤と青を線上に色付けされたフリンジのために、動かして下さい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨간색과 파란색을 분리하여 라인에 색깔이있는 끈을 옮기십시오"
          }
        }
      }
    },
    "Moves the picture left or right.": {
