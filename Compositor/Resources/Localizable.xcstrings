          }
        }
      }
    },
    "How many spikes each light has, as the lens's aperture blades make them": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个光源产生的星芒数量，模拟镜头光圈叶片的效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個光源產生的星芒數量，模擬鏡頭光圈葉片的效果。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de pics chaque lumière a, comme les lames d'ouverture de l'objectif les font"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Spikes hat jedes Licht, wie die Blendenblätter der Linse sie machen"
          }
