    "Parametric lifts tonal regions. Point places anchors on the curve.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametrisch hebt die Tonregionen an, Punktpunkte legen auf der Kurve Anker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevadores paramétricos regiones tonales. Puntos ancla en la curva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point place les ancres sur la courbe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パラメトリックは、トーン領域を持ち上げます。ポイントはカーブの上にアンカーを配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파라미터는 톤 지역을 올립니다.점은 곡선에 앵커를 배치합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「参数」调整各个色调区域。「点」在曲线上添加锚点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「引數」調整各個色調區域。「點」在曲線上新增錨點。"
          }
        }
      }
    },
