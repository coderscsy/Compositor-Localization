    "Other formats: TIFF, PDF and GIF%@, Channel Pack for game textures, and PSD to keep the layers for Photoshop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Formate: TIFF, PDF und GIF %@, Channel Pack für Spieltexturen und PSD zum Speichern der Ebenen für Photoshop"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros formatos: TIFF, PDF y GIF %@ , Channel Pack para las texturas del juego, y PSD para mantener las capas de Photoshop"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autres formats : TIFF, PDF et GIF %@ , Channel Pack pour les textures de jeu et PSD pour garder les calques pour Photoshop"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のフォーマット:TIFF、PDFおよびGIF %@のゲームの質のチャネルのパックおよびPhotoshopのための層を保つPSD"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 형식: TIFF, PDF 및 GIF %@ , 게임 텍스처를 위한 채널 패키지, 그리고 Photoshop을 위한 레이어를 유지하기 위한 PSD"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他格式：TIFF、PDF 和 GIF%@。可使用通道打包制作游戏纹理，或用 PSD 保留图层供 Photoshop 编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他格式：TIFF、PDF 和 GIF%@。可使用通道打包製作遊戲紋理，或用 PSD 保留圖層供 Photoshop 編輯。"
          }
        }
      }
    },
