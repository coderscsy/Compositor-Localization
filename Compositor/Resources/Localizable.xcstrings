    "Shift-click adds a color, Option-click takes one away.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 点按可添加颜色，按住 Option 点按可移除颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 點按可新增顏色，按住 Option 點按可移除顏色。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maj-clic ajoute une couleur, Option-click en enlève un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-Click fügt eine Farbe hinzu, Option-Click nimmt eine weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de movimiento añade un color, el clic de opción se lleva uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-click は色を追加し、Option-click は 1 つを取り除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-click는 색상을 추가하고 Option-click는 하나를 제거합니다."
          }
        }
      }
    },
    "Shift-U (or Tab) steps through Rectangle, Ellipse and Line": {
      "localizations": {
