    "Hue shifts the color, Saturation its strength, and Luminance its brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相改变颜色，饱和度控制色彩浓度，明亮度控制颜色的明暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色相改變顏色，飽和度控制色彩濃度，明亮度控制顏色的明暗。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue déplace la couleur, sa saturation sa force, et Luminance sa luminosité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbton verschiebt die Farbe, Sättigung seine Stärke und Leuchtkraft seine Helligkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue cambia el color, Saturación su fuerza, y Luminance su brillo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色をシフトし、その強度を飽和させ、明るさを輝かせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색조는 색상을, 채도는 색상의 강도를, 광도는 색상의 밝기를 조정합니다."
          }
        }
      }
    },
