    "Opacity digit 0 (type two for exact %)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taste 0 für die Deckkraft (zwei Ziffern für den genauen Wert in % eingeben)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla 0 para la opacidad (introduce dos cifras para indicar el % exacto)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche 0 pour l’opacité (saisir deux chiffres pour une valeur exacte en %)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明度の数字キー 0（正確な % を指定するには数字を 2 桁入力）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불투명도 숫자 키 0(정확한 %는 두 자리 입력)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明度数字 0（连按两位可精确设置百分比）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明度數字 0（連按兩位可精確設定百分比）"
          }
        }
      }
    },
