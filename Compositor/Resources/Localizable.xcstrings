    "Adds film grain, strongest in the middle tones.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Filmkorn hinzu, am stärksten in den Mitteltönen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade grano de película, más fuerte en los tonos medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute du grain de film, le plus fort dans les tons du milieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルムの穀物を、中間の調子で最も強い加えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화 곡물, 중간 톤에서 가장 강한 추가."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，中间调的颗粒最明显。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增膠片顆粒，中間調的顆粒最明顯。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Grün oder Magenta zu den dunkelsten Tönen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade verde o magenta a los tonos más oscuros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter le vert ou le magenta aux tons les plus foncés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑またはマゼンタを最も暗い色調に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 어두운 톤에 녹색 또는 마겐타를 추가합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为最暗的色调添加绿色或洋红色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為最暗的色調新增綠色或洋紅色。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt hinzu oder weicht den Kontrast entlang breiterer Formen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o suaviza el contraste a lo largo de formas más amplias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ou adoucit le contraste sur des formes plus larges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より広い形状に沿ってコントラストを追加または柔らかくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넓은 모양을 따라 대조 또는 부드러움."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱较大轮廓的对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強或減弱較大輪廓的對比度。"
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "extractionState": "manual",
