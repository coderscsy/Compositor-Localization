    "Drag to select · Drag inside to move · Shift add · Option subtract · Delete clears · ⌥⌫/⌘⌫ fill · ⌘D deselect": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动创建选区 · 拖动选区内部以移动 · Shift 添加 · Option 减去 · Delete 清除 · ⌥⌫/⌘⌫ 填充 · ⌘D 取消选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動建立選區 · 拖動選區內部以移動 · Shift 新增 · Option 減去 · Delete 清除 · ⌥⌫/⌘⌫ 填充 · ⌘D 取消選擇"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour sélectionner · Faites glisser à l'intérieur pour se déplacer · Maj ajouter · Option soustraire · Supprimer les blancs · ⌥⌫ / ⌘⌫ remplir · ⌘D désélectionner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie zum Auswählen · Ziehen Sie nach innen, um sich zu bewegen · Schieben Sie das Addieren · Option subtrahieren · Löschen löscht · ⌥⌫ / ⌘⌫ füllen · ⌘D deselect"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre para seleccionar · Arrastre dentro para moverse · Agregue el subtracto de opción · Borrar los despejos · ⌥⌫ / ⌘⌫ relleno · ⌘D deselección"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択するドラッグ・中に移動・シフト追加・オプションサブトラクト・クリア削除・⌥⌫/⌘⌫ フィリング・⌘Dデセレクト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌기 선택 · 끌기 내부 이동 · Shift 추가 · 옵션 하위 추출 · 삭제 클리어 · ⌥⌫ / ⌘⌫ 채우기 · ⌘D 제거"
          }
        }
      }
    },
    "Drag to set hue and saturation. Double-click to reset this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以设置色相和饱和度，连按两下可重置此色轮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動以設定色相和飽和度，連按兩下可重置此色輪。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour définir la teinte et la saturation. Double-cliquez pour remettre cette roue à zéro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie, um Farbton und Sättigung einzustellen. Doppelklicken Sie, um dieses Rad zurückzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre para establecer el casco y la saturación. Haga doble clic para restablecer esta rueda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hueと飽和を設定するためにドラッグします。このホイールをリセットするにはダブルクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 바퀴를 다시 설정하려면 두 번 클릭합니다."
          }
        }
      }
    },
    "Drag to smudge": {
      "extractionState": "manual",
      "localizations": {
