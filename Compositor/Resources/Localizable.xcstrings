          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓彩色斑點融入周圍顏色的程度。"
          }
        }
      }
    },
    "How much fine texture and edges are kept while the grain is smoothed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel feine Textur und Kanten gehalten werden, während das Korn geglättet wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánta textura fina y los bordes se mantienen mientras el grano se suaviza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de texture fine et les bords sont conservés pendant que le grain est lissé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "粒が滑らかになる間どれだけの細かい質感とエッジが保持されるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 많은 얇은 구조와 가장자리가 곡물이 부드러워질 때 유지되는지"
          }
        },
        "zh-Hans": {
