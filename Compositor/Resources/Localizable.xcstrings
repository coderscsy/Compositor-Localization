    "Light blooming around the lines, like a CRT's phosphors": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht blüht um die Linien, wie ein CRT-Leuchtstoffe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz florece alrededor de las líneas, como los fósforos de un CRT"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière fleurit autour des lignes, comme les phosphores d'un CRT"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CRTの蛍光体のような線の周りに咲く光"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라인 주위에 빛이 꽃을 피우고, CRT의 화석처럼"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描线周围的辉光，类似 CRT 显示器的荧光效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描線周圍的輝光，類似 CRT 顯示器的熒光效果。"
          }
        }
      }
    },
    "Light gathered at each disc's rim, as some lenses draw it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht sammelte sich an jedem Scheibenrand, wie einige Linsen es zeichnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz reunida en el borde de cada disco, como algunos lentes dibujan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière s'est recueillie sur le jante de chaque disque, comme certains objectifs le dessinent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ディスクのリムに集められたライトは、一部のレンズがそれを描画するので"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛은 각 디스크의 림에 모여, 일부 렌즈가 그것을 끌어"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制光线在散景光斑边缘的聚集程度，模拟部分镜头的表现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制光線在散景光斑邊緣的聚集程度，模擬部分鏡頭的表現。"
          }
        }
      }
    },
