          "stringUnit": {
            "state": "translated",
            "value": "가장 어두운 지점을 설정하십시오. 옵션을 유지하여 스크립트 그림자를 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
