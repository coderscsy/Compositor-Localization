            "state": "translated",
            "value": "高质量"
          }
        }
      }
    },
    "Highlight Clipping Indicator": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光剪切指示器"
          }
        }
      }
    },
    "Highlight Priority": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光优先"
          }
        }
      }
    },
    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「高光优先」保护边缘亮部，「颜色优先」还会降低颜色饱和度，「绘画叠加」均匀覆盖边缘。"
          }
        }
      }
    },
    "Highlight Recovery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光恢复"
          }
        }
      }
    },
    "Highlights": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光"
          }
        }
      }
    },
    "Histogram": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
