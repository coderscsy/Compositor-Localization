    "RGB changes brightness. Red, green, and blue also shift the color.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB ändert die Helligkeit. Rot, Grün und Blau verschieben auch die Farbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB cambia el brillo. Rojo, verde y azul también cambia el color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB change de luminosité. Rouge, vert et bleu changent également la couleur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RGBは明るさを変えます。赤、緑、青も色をシフトします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB는 밝기를 변경합니다. 빨간색, 녹색 및 파란색은 색상을 변경합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB 曲线调整亮度。红、绿、蓝通道曲线还会改变颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB 曲線調整亮度。紅、綠、藍通道曲線還會改變顏色。"
          }
        }
      }
    },
