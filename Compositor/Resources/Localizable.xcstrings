    "Zoom in (⌘+), now %@. At 100%% each pixel of the export is one pixel of the screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom in ( ⌘+), jetzt %@ . Bei 100 %% ist jedes Pixel des Exports ein Pixel des Bildschirms"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom en ( ⌘+ ), ahora %@ . A 100 %% cada pixel de la exportación es un pixel de la pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom dans ( ⌘+ ), maintenant %@ . À 100 %% chaque pixel de l'exportation est un pixel de l'écran"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大（⌘+）。現在は %@ です。100%% では、書き出す画像の 1 ピクセルが画面の 1 ピクセルに対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom in ( ⌘+ ), now %@ . at 100 %% 각 픽셀의 수출은 화면의 하나의 픽셀입니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大（⌘+），当前为 %@。在 100%% 下，导出图像的每个像素对应一个屏幕像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大（⌘+），當前為 %@。在 100%% 下，匯出影象的每個畫素對應一個螢幕畫素。"
          }
        }
      }
    },
