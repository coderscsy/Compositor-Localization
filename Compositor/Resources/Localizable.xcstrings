    "Darker or lighter before the lines are drawn": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkler oder heller, bevor die Linien gezeichnet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más oscuro o más ligero antes de que las líneas se dibujan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus foncé ou plus léger avant que les lignes ne soient tracées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線が引かれる前に暗いかより軽いです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라인이 끌려오기 전에 더 어둡거나 가벼운"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制扫描线前调暗或调亮图像。"
