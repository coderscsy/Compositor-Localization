    "Protect bright areas near the edge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护边缘附近的亮部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護邊緣附近的亮部。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protéger les zones lumineuses près du bord"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützen Sie helle Bereiche in der Nähe des Randes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteger zonas brillantes cerca del borde"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジの近くで明るいエリアを保護"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆에 있는 밝은 지역을 보호합니다"
          }
        }
      }
    },
    "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加暗角时保护亮部像素。用于「高光优先」模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增暗角時保護亮部畫素。用於「高光優先」模式。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protège les pixels lumineux pendant qu'une vignette sombre est appliquée. Utilisé par Highlight Priority."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützt helle Pixel, während eine dunkle Vignette angebracht wird. Verwendet von Highlight Priority."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege píxeles brillantes mientras se aplica una Vignette oscura. Utilizado por Highlight Priority."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗いビネットが適用される間、明るいピクセルを保護します。 Highlight優先順位で使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝은 픽셀을 보호하는 동안 어두운 비네트가 적용됩니다."
          }
        }
      }
    },
    "Proximity Match": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
