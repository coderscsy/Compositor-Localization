    "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选区过于复杂，无法生成轮廓。请调整「容差」或启用「连续」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取範圍過於複雜，無法產生輪廓。請調整「容差」或啟用「連續」。"
          }
        }
      }
    },
    "That shape is too large. A shape can cover up to %lld megapixels.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
