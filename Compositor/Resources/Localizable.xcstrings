    "Set a radius above 0 to use smooth corners.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie einen Radius über 0 ein, um glatte Ecken zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece un radio por encima de 0 para usar esquinas lisas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez un rayon au-dessus de 0 pour utiliser des coins lisses."
          }
        },
