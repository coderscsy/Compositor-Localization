    "Your changes will be lost if you don’t save them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Änderungen gehen verloren, wenn Sie sie nicht speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cambios se perderán si no los salvas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos changements seront perdus si vous ne les sauvegardez pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しない場合、変更内容は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 변화는 당신이 그들을 저장하지 않는 경우에 잃어 버릴 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭前若未保存，更改将会丢失。"
