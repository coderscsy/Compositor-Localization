    "Solid, dashed or dotted; dashes grow with the line's width": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选择实线、虚线或点线；虚线线段随线宽增大"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選擇實線、虛線或點線；虛線線段隨線寬增大"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solide, pointillé ou pointillé; les tirets croissent avec la largeur de la ligne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fest, gestrichelt oder gepunktet; mit der Breite der Linie wachsende Striche"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólidos, desgarrados o dotados; las pestañas crecen con el ancho de la línea"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固体、土または点を打たれる;ダッシュはラインの幅と育ちます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "견고한, 다이어트 또는 다이어트; 다이어트는 라인의 폭과 함께 성장"
          }
        }
      }
    },
    "Split Channels": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拆分通道"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拆分通道"
          }
