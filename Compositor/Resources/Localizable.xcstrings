    "Limits sharpening to stronger edges. Hold Option to see the mask.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenzwerte für das Schärfen an stärkeren Kanten. Halten Sie die Option, um die Maske zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita el afilado a bordes más fuertes. Sostenga la opción de ver la máscara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites d'affûtage aux bords plus forts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より強固なエッジにシャープニングを制限します。 マスクを見るにはオプションを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 강한 가장자리로 격추하는 한계.마스크를 볼 수있는 옵션을 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将锐化限制在较明显的边缘。按住 Option 键可查看蒙版。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將銳化限制在較明顯的邊緣。按住 Option 鍵可檢視遮色片。"
