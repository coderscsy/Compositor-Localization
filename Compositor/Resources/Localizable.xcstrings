    "Units: pixels, inches, centimeters or millimeters. Click to switch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einheiten: Pixel, Zoll, Zentimeter oder Millimeter."
          }
        },
        "es": {
