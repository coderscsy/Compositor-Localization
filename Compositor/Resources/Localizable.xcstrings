    "Let the lights glow in the air around the subject, blending them into the background": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让光线在主体周围产生辉光，与背景自然融合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓光線在主體周圍產生輝光，與背景自然融合。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez les lumières briller dans l'air autour du sujet, en les mélangeant dans le fond"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie die Lichter in der Luft um das Motiv herum leuchten und sie in den Hintergrund mischen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que las luces resplandoren en el aire alrededor del tema, mezclandolas en el fondo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "被写体の周りに空気に光を浴びて、それらを背景にブレンドしてみましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제 주위의 공기에서 빛을 밝게하고 배경에 혼합하십시오"
          }
        }
      }
    },
    "Levels": {
      "extractionState": "manual",
