    "Paint with the foreground color (B), or erase pixels away (E)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用前景色绘制（B），或擦除像素（E）"
          }
        },
        "zh-Hant": {
