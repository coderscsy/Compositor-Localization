    "Make each dithered pixel this many pixels across, for a chunky old-screen look": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie jedes dithered Pixel so viele Pixel über, für einen klobigen alten Bildschirm-Look"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer cada pixel condimentado este muchos píxeles a través, para un look de pantalla vieja chunky"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites chaque pixel dithered ce nombre de pixels à travers, pour un look vieux écran chunky"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ダイザードピクセルは、この多くのピクセルを、チャンキーの古い画面の外観のために、"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각각의 녹은 픽셀이 여러 픽셀을 통과하여, 오래된 스크린으로 보이기 위해"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将抖动后的像素放大为指定的像素宽度，模拟老式屏幕的粗像素效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將抖動後的畫素放大為指定的畫素寬度，模擬老式螢幕的粗畫素效果。"
          }
        }
      }
    },
    "Make the lines waver sideways down the screen, like a CRT losing sync": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie die Linien wackeln seitlich auf dem Bildschirm, wie ein CRT verliert Synchronisation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer las líneas de onda hacia abajo en la pantalla, como un CRT perdiendo sincronización"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire les lignes vaguer latéralement vers le bas de l'écran, comme un CRT perdant la synchronisation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CRTの負け同期のように、ラインを横切って画面を作ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라인 웨버 측면을 화면 아래로 만들기, CRT 손실 동기화와 같은"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使扫描线在屏幕上左右摆动，模拟 CRT 显示器失去同步的效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使掃描線在螢幕上左右擺動，模擬 CRT 顯示器失去同步的效果。"
          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht helle und dunkle Töne mehr oder weniger unterschiedlich, meist in der Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que los tonos ligeros y oscuros sean más o menos diferentes, sobre todo alrededor del medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait des tons clairs et sombres plus ou moins différents, principalement autour du milieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光と暗い色は、ほぼ中央の周りに、より異なっている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그것은 밝고 어두운 톤을 더 또는 덜 다르게 만듭니다, 대부분 중간 주위."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加或减小明暗色调的差异，主要影响中间调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增加或減小明暗色調的差異，主要影響中間調。"
          }
        }
      }
    },
    "Makes the color smoothing softer or tighter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht die Farbe glatter weicher oder enger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el color suavizar más suave o más ajustado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre la couleur lisse plus douce ou plus serrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "柔らかさやキツルを滑らかにする色を作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색깔을 더 부드럽거나 더 단단하게 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整色彩降噪的平滑程度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整色彩降噪的平滑程度。"
          }
        }
      }
    },
    "Makes the grain coarser or finer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Korn wird gröber oder feiner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace el grano más grueso o más fino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend le grain plus grossier ou plus fin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穀物の粗いかより細かい作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡물이 더 부드럽거나 얇게 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让颗粒更粗或更细。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓顆粒更粗或更細。"
          }
        }
      }
    },
    "Makes the grain smoother or more uneven.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macht das Korn glatter oder unebener."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el grano sea más suave o más desigual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend le grain plus lisse ou plus inégal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穀物を滑らかにするか、またはより多くの不均等にして下さい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡물을 더 부드럽거나 불평등하게 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让颗粒更平滑或更粗糙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓顆粒更平滑或更粗糙。"
          }
        }
      }
    },
    "Makes the picked color lighter or darker.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht die gewählte Farbe heller oder dunkler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el color elegido sea más ligero o más oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre la couleur cueillie plus claire ou plus sombre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピックアップされたカラーライターやダークな色を作る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 색깔을 더 밝거나 어두워집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调亮或调暗取样颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調亮或調暗取樣顏色。"
          }
        }
      }
    },
    "Makes the picked color stronger or quieter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht die gewählte Farbe stärker oder leiser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el color elegido sea más fuerte o más silencioso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre la couleur choisie plus forte ou plus silencieuse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピックされた色を強くしたり、より静かにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 색깔을 더 강하거나 조용하게 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱取样颜色的浓度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強或減弱取樣顏色的濃度。"
          }
        }
      }
    },
    "Makes the selected color family lighter or darker.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht die ausgewählte Farbfamilie heller oder dunkler."
