    "Lift the lines where the picture is bright, or lower them when negative, so they swell into its shapes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随图像亮度改变扫描线的起伏。亮处的线条上抬，负值则下压。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨影象亮度改變掃描線的起伏。亮處的線條上抬，負值則下壓。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulevez les lignes où l'image est lumineuse, ou baissez-les quand négatif, de sorte qu'ils gonflent dans ses formes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heben Sie die Linien, wo das Bild hell ist, oder senken Sie sie, wenn negativ, so dass sie in seine Formen anschwellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar las líneas donde la imagen es brillante, o bajarlas cuando son negativas, por lo que se hinchan en sus formas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵が明るい線を持ち上げたり、ネガの時にそれらを下げるので、彼らはその形状に腫れます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림이 밝은 라인을 올리거나, 부정적인 경우에 그들을 낮추면 그들이 형태로 팽창합니다"
          }
        }
      }
    },
    "Lifts or lowers the brightest tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调亮或调暗最明亮的色调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調亮或調暗最明亮的色調。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève ou baisse les tons les plus brillants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt oder senkt die hellsten Töne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o baja los tonos más brillantes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リフトまたは最も明るいトーンを下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 밝은 톤을 높이거나 낮추십시오."
          }
        }
      }
    },
    "Lifts or lowers the dark tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调亮或调暗暗调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調亮或調暗暗調。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulève ou abaisse les tons sombres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt oder senkt die dunklen Töne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o baja los tonos oscuros."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗いトーンを持ち上げたり下げたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 톤을 높이거나 낮추십시오."
          }
        }
      }
    },
    "Lifts or lowers the darkest tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
