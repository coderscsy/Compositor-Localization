    "Tones from black on the left to white on the right: blacks, shadows, midtones, highlights, whites. Control-click to show the vectorscope.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Schwarz links nach Weiß rechts: Schwarz, Schatten, Mitteltöne, Highlights, Weiß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonos de negro a la izquierda al blanco a la derecha: negros, sombras, midtones, relieves, blancos. Control-click para mostrar el vectorscopio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des tons noirs sur la gauche au blanc sur la droite : noirs, ombres, midtones, reflets, blancs. Contrôle-cliquez pour afficher le vectorscope."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左から右側の白に黒いトーン:黒、シャドウ、真鍮、ハイライト、白。 ベクタースコープを表示するには、コントロールクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽에 검정색에서 오른쪽에 흰색으로 톤 : 블랙, 그림자, 중간 톤, 강조, 흰색."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色调由左至右从黑到白，依次为黑色、阴影、中间调、高光、白色。按住 Control 键点按可显示矢量示波器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色調由左至右從黑到白，依次為黑色、陰影、中間調、高光、白色。按住 Control 鍵點按可顯示向量示波器。"
          }
        }
      }
    },
    "Tones per channel: 2 is pure black and white": {
      "localizations": {
        "de": {
