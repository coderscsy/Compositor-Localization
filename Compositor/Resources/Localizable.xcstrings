    "Drag a color in the picture. Nearby color families move together.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图像上的某种颜色处拖动，相近颜色会一同调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在影象上的某種顏色處拖動，相近顏色會一同調整。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une couleur dans l'image. Les familles de couleurs proches se déplacent ensemble."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie eine Farbe im Bild. Nahe gelegene Farbfamilien bewegen sich zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un color en la imagen. Las familias de color cercanos se mueven juntas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色をイメージでドラッグします。近辺のカラーファミリーが一緒に動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림에 색을 끌어 올리십시오.가까운 색상 가족이 함께 이동합니다."
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可调整点。点按以添加，连按两下以移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動可調整點。點按以新增，連按兩下以移除。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un point. Cliquez pour en ajouter un. Double-cliquez sur un point pour le supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Punkt. Klicken Sie, um einen hinzuzufügen. Doppelklicken Sie auf einen Punkt, um ihn zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un punto. Haga clic para añadir uno. Haga doble clic en un punto para eliminarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点をドラッグします。 1 つを追加するためにクリックします。ポイントをダブルクリックして削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인트를 끌어내기 위해 한 점을 추가하려면 클릭하십시오."
          }
        }
      }
    },
    "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动绘制矩形 · Shift 添加 · Option 减去 · 拖动中再按 Shift 绘制正方形 · 拖动选区内部以移动 · 按住 ⌘ 拖动可移动像素 · Delete 清除 · ⌘D 取消选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動繪製矩形 · Shift 新增 · Option 減去 · 拖動中再按 Shift 繪製正方形 · 拖動選區內部以移動 · 按住 ⌘ 拖動可移動畫素 · Delete 清除 · ⌘D 取消選擇"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire glisser un rectangle · Maj ajouter · Option soustraire · Majer de nouveau le carré mi-drag · Faire glisser à l'intérieur pour se déplacer · ⌘ -drag déplace les pixels · Supprimer les effacements · ⌘D désélectionner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie ein Rechteck · Shift add · Option subtrahieren · Verschieben Sie erneut das mittlere Quadrat · Ziehen Sie nach innen, um sich zu bewegen · ⌘ -Drag bewegt Pixel · Löschen löscht · ⌘D deselect"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un rectángulo · Arrastre un rectángulo · Subtracto de Opción · Cambio de nuevo cuadrado medio-drag · Arrastre hacia adentro para moverse · ⌘ -diga movimientos pixels · Borrar los deselementos · ⌘D"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長方形・シフトを追加・オプションのサブトラクト・シフトを再びミッドドラッグスクエア・ドラッグインサイドに移動・⌘-drag 移動ピクセル・削除クリアー・⌘D deselect"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직경 끌기 · Shift 추가 · 옵션 하위 트랙 · 다시 중간 트랙 평방을 옮기기 · 이동하기 위해 내부를 끌기 · ⌘ -트랙 픽셀을 움직이기 · 클리어 삭제 · ⌘D deselect"
          }
        }
      }
    },
    "Drag a text box · Click text to edit · Drag box handles to resize · ⌘Return finish · Escape cancel": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动创建文本框 · 点按文字以编辑 · 拖动控制点调整大小 · ⌘回车完成 · Esc 取消"
