          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peinture avec la couleur de premier plan (B), ou effacer les pixels (E)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Malen Sie mit der Vordergrundfarbe (B) oder löschen Sie Pixel weg (E)"
          }
        },
        "es": {
          "stringUnit": {
