    "Weakens green fringes inside the green hue range.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱指定绿色色相范围内的色边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減弱指定綠色色相範圍內的色邊。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faibles franges vertes à l'intérieur de la gamme de teintes vertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwächt die grünen Fransen innerhalb des grünen Farbtonbereichs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Humedece fringes verdes dentro de la gama de colores verdes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑の色合いの範囲内の緑色のフリンジを弱めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹색 구멍 범위 내부에 녹색 구멍을 약화합니다."
          }
        }
      }
    },
    "Weakens purple fringes inside the purple hue range.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱指定紫色色相范围内的色边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減弱指定紫色色相範圍內的色邊。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faibles franges violettes à l'intérieur de la gamme des teintes violettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwächt lila Fransen innerhalb der violetten Farbton Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debilita fringes púrpura dentro de la gama de tonalidades púrpuras."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紫の色合いの範囲内の紫色のフリンジを弱めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "푸른 껍질의 범위 내부에 푸른 껍질을 약화합니다."
          }
        }
      }
    },
    "What fills the %@ channel: a layer or group read as grayscale, or solid black or white": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@通道的填充内容：图层或组的灰度值，或者纯黑或纯白。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@通道的填充內容：圖層或組的灰度值，或者純黑或純白。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui remplit le canal %@ : une couche ou un groupe de couches lues comme grayscale, ou solide noir ou blanc"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was den %@-Kanal füllt: eine Schicht oder Gruppe, die als Graustufen gelesen wird oder schwarz oder weiß ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que llena el canal %@: una capa o grupo leído como grayscale, o sólido negro o blanco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@チャンネルを埋めるもの:レイヤーまたはグループがグレースケールとして読み取り、またはソリッドブラックまたはホワイト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 채널을 채우는 것은 무엇입니까: 층 또는 그룹은 회색으로 읽거나 단단한 검정색 또는 흰색으로 읽습니다"
          }
        }
      }
    },
