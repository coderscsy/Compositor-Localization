    "Perspective allows stronger keystone. Rectilinear keeps the warp gentler.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Perspektive erlaubt einen stärkeren Schlussstein. Geradlinig hält die Warp sanfter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perspectiva permite una piedra clave más fuerte. Rectilinear mantiene la warp más suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perspective permet une pierre clé plus forte. Rectiligne garde la chaîne plus douce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パースペクティブは、より強力なキーストーンを可能にします。 リクティリナーは、ワープを優しく保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전망은 더 강한 키스톤을 허용합니다.Rectilinear는 벽돌을 부드럽게 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「透视」允许更大幅度的梯形校正。「直线」的变形更柔和。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「透視」允許更大幅度的梯形校正。「直線」的變形更柔和。"
          }
        }
      }
    },
