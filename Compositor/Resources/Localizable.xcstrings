    "Break the lines into beads where the picture is darker than this, blending into solid lines where it's brighter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brechen Sie die Linien in Perlen, wo das Bild dunkler ist als diese, Verschmelzung in durchgezogene Linien, wo es heller ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompe las líneas en cuentas donde la imagen es más oscura que esta, mezclando en líneas sólidas donde es más brillante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découpez les lignes en perles où l'image est plus sombre que ça, se mélangeant en lignes solides où il est plus lumineux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線を曲げて、その画像がより濃くなり、より明るいラインにブレンドします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림이 이것보다 어두운 곳에 라인을 찢어 놓고, 밝은 곳에 단단한 라인으로 혼합"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于此亮度的扫描线呈点状，高于此亮度的部分逐渐过渡成实线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於此亮度的掃描線呈點狀，高於此亮度的部分逐漸過渡成實線。"
          }
        }
      }
    },
    "Brightens or darkens the corners to counter lens falloff.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhellt oder verdunkelt die Ecken, um dem Linsenabfall entgegenzuwirken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brillo o obscurece las esquinas para contrarrestar la caída del objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumine ou assombrit les coins pour contrer la chute de la lentille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズの落下を対向するためにコーナーを明るくするか、または暗くして下さい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈의 파로프를 방지하기 위해 구석을 밝게하거나 어둡게합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调亮或调暗图像四角，以补偿镜头边缘的亮度衰减。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調亮或調暗影象四角，以補償鏡頭邊緣的亮度衰減。"
          }
        }
      }
    },
    "Brightens or darkens the whole picture, in stops of light. Hold Option to see clipped highlights.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heller oder dunkler wird das ganze Bild, in Lichtblenden. Halten Sie die Option, um abgeschnittene Highlights zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brillo o obscurece toda la imagen, en paradas de luz. Sostenga la opción para ver los relieves recortados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightens ou assombrit l'image entière, dans les arrêts de la lumière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るく、または光の停止で全体の画像を暗くします。クリップされたハイライトを表示するオプションを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛이 멈추거나 전체 그림을 밝히거나 어둡게합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以曝光级数调亮或调暗整张图像。按住 Option 键可查看高光剪切。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以曝光級數調亮或調暗整張影象。按住 Option 鍵可檢視高光剪下。"
          }
        }
      }
    },
