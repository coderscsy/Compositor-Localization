            "state": "translated",
            "value": "%@ %@ está ahora disponible — usted tiene %@ . ¿Quiere descargarlo ahora?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ が利用可能になりました。%@ です。今すぐダウンロードしてみませんか?"
