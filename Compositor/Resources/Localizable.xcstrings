    },
    "How many times the picture echoes, each fainter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft das Bild widerhallt, jeder schwächere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuantas veces se hace eco de la imagen, cada más débil"
          }
        },
        "fr": {
