    "GIF keeps fully transparent or opaque pixels; soft edges use a 50% threshold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF hält vollständig transparente oder undurchsichtige Pixel; weiche Kanten verwenden einen Schwellenwert von 50%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF mantiene píxeles totalmente transparentes o opacos; los bordes blandos usan un umbral del 50%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF garde des pixels transparents ou opaques; les bords souples utilisent un seuil de 50%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFは完全に透明または不透明ピクセルを保持します。柔らかいエッジは50%のしきい値を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF는 완전히 투명하거나 눈에 띄지 않은 픽셀을 유지합니다; 부드러운 경계선은 50 %의 한도를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 像素只能完全透明或完全不透明。柔和边缘使用 50% 的阈值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 畫素只能完全透明或完全不透明。柔和邊緣使用 50% 的閾值。"
          }
        }
      }
    },
