    "Use 1–%@ pixels per side, up to %lld megapixels, and 1–9,600 pixels/inch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边须为 1–%@ 像素，总像素数最多为 %lld 百万像素，分辨率须为 1–9,600 像素/英寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每邊須為 1–%@ 畫素，總畫素數最多為 %lld 百萬畫素，解析度須為 1–9,600 畫素/英寸。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 1– %@ pixels de chaque côté, jusqu'à %lld mégapixels et 1–9600 pixels/pouce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie 1–%@ Pixel pro Seite, bis zu %lld Megapixel und 1–9.600 Pixel/Zoll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar 1– %@ píxeles por lado, hasta %lld megapíxeles y 1–9,600 píxeles/inch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一辺は1〜%@ピクセル、全体は最大%lldメガピクセル、解像度は1〜9,600ピクセル/インチです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측면에 1~%@ 픽셀, 최대 %lld 메가 픽셀 및 1~9,600 픽셀/인치 사용."
          }
        }
      }
    },
    "Use a CMYK ICC profile, such as the one your printer gave you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 CMYK ICC 配置文件，例如印刷服务商提供的文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 CMYK ICC 配置檔案，例如印刷服務商提供的檔案"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un profil CMYK ICC, comme celui que votre imprimante vous a donné"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie ein CMYK ICC-Profil, wie das, das Ihr Drucker Ihnen gegeben hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice un perfil CMYK ICC, como el que su impresora le dio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷業者から提供されたものなど、CMYK ICCプロファイルを使用します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CMYK ICC 프로필을 사용하십시오, 예를 들어 프린터가 제공 한 것과 같습니다"
          }
        }
      }
    },
    "Use gridlines every %lld–%@ pixels and %lld–%lld subdivisions, no more than the pixels between gridlines.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格线间距须为 %lld–%@ 像素。子网格数须为 %lld–%lld，且不能超过网格线之间的像素数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網格線間距須為 %lld–%@ 畫素。子網格數須為 %lld–%lld，且不能超過網格線之間的畫素數。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les lignes de grilles toutes les subdivisions %lld – %@ pixels et %lld – %lld, pas plus que les pixels entre les lignes de grille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Rasterlinien alle %lld-%@-Pixel und %lld-%lld-Unterteilungen, nicht mehr als die Pixel zwischen den Rasterlinien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice rejillas cada %lld – %@ pixels y %lld – %lld subdivisiones, no más que los píxeles entre rejillas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld – %@ ピクセルと %lld - %lld サブディビジョンごとにグリッドラインを使用して、グリッド線間のピクセル以上は使用しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 %lld - %@ 픽셀 및 %lld - %lld 하위 부서를 사용하십시오, 그 사이의 픽셀을 초과하지 않습니다."
          }
        }
      }
    },
    "Use smooth squircle corners at 60% smoothing, matching Figma's iOS setting": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用平滑度为 60% 的圆角，与 Figma 的 iOS 设置一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用平滑度為 60% 的圓角，與 Figma 的 iOS 設定一致"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser des coins squircles lisses à 60%, en fonction du réglage iOS de Figma"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie glatte Eichhörnchen-Ecken bei 60% Glättung, passend zu Figmas iOS-Einstellung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice esquinas suaves del squircle al 60% suavizar, ajuste de Figma iOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma の iOS の設定にマッチする、60% のスムージングで滑らかな小角を使用して下さい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma의 iOS 설정과 일치하는 60 % 부드러움에서 부드러운 둥근 구석을 사용하십시오"
          }
        }
      }
    },
