    "Put each pixel's brightness back afterwards, so only the color moves": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie die Helligkeit jedes Pixels danach zurück, so dass sich nur die Farbe bewegt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponga el brillo de cada pixel después, así que sólo el color se mueve"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remettre la luminosité de chaque pixel après, donc seulement la couleur bouge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ピクセルの明るさを後方に置くので、色だけが動かします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 픽셀의 밝기를 나중에 다시 넣으므로 색상만 이동합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整后恢复各像素的亮度，仅改变颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整後恢復各畫素的亮度，僅改變顏色。"
