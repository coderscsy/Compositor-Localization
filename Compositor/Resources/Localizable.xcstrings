    "How bright the lines are where the picture is black, so they show even over black": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie hell die Linien sind, wo das Bild schwarz ist, so dass sie sogar über Schwarz zeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué brillantes son las líneas donde la imagen es negra, así que se muestran incluso sobre negro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme les lignes sont brillantes là où l'image est noire, alors elles montrent même sur noir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線が黒いところにあるので、黒色に表示する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 밝은 라인은 그림이 검은 곳, 그래서 그들은 심지어 검은 위에 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑色区域中扫描线的亮度。提高此值可让扫描线在纯黑处显现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "黑色區域中掃描線的亮度。提高此值可讓掃描線在純黑處顯現。"
          }
        }
      }
    },
