    "Hue and saturation of this wheel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbton und Sättigung dieses Rades."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hueso y saturación de esta rueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue et saturation de cette roue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホイールの色合いと飽和。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 바퀴의 부드러움과 부드러움."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此色轮的色相和饱和度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此色輪的色相和飽和度。"
          }
        }
      }
    },
    "Hue around the wheel, saturation outward from the center. Control-click to show the histogram.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbton um das Rad, Sättigung von der Mitte nach außen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Huele alrededor de la rueda, saturación hacia fuera desde el centro. Control-clic para mostrar el histograma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courir autour de la roue, saturation vers l'extérieur du centre. Contrôlez-cliquez pour afficher l'histogramme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイールの周りを Hue, 中心から外側に飽和. コントロールクリックしてヒストグラムを表示."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바퀴 주위에, 중앙에서 밖으로 만족. 컨트롤 클릭 이스트그램을 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环绕色轮的角度表示色相，距中心的距离表示饱和度。按住 Control 键点按可显示直方图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環繞色輪的角度表示色相，距中心的距離表示飽和度。按住 Control 鍵點按可顯示直方圖。"
          }
        }
      }
    },
    "Hue range where green defringe runs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue Bereich, wo Green Defringe läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango de Hueso donde corre el desfrige verde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue gamme où le défringe vert court."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑のデフリンジが動く Hue の範囲。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹색이 흐르는 곳에서 녹색이 흐르는 곳입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去除绿边所适用的色相范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去除綠邊所適用的色相範圍。"
          }
        }
      }
    },
    "Hue range where purple defringe runs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue Bereich, wo lila Defringe läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango de Hueso donde corre el desfrige púrpura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue gamme où le défringe violet court."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パープルデフリンジが実行する Hue の範囲。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이의 범위는 푸르트 드프링이 실행되는 곳입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去除紫边所适用的色相范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去除紫邊所適用的色相範圍。"
          }
        }
      }
    },
    "Hue shifts the color, Saturation its strength, and Luminance its brightness.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbton verschiebt die Farbe, Sättigung seine Stärke und Leuchtkraft seine Helligkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue cambia el color, Saturación su fuerza, y Luminance su brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue déplace la couleur, sa saturation sa force, et Luminance sa luminosité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色をシフトし、その強度を飽和させ、明るさを輝かせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색조는 색상을, 채도는 색상의 강도를, 광도는 색상의 밝기를 조정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相改变颜色，饱和度控制色彩浓度，明亮度控制颜色的明暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色相改變顏色，飽和度控制色彩濃度，明亮度控制顏色的明暗。"
          }
        }
      }
    },
