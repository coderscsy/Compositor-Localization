        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강점은 이미 강한 색상보다 조용한 색상을 더 강화하고 피부 톤을 보호합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先增强低饱和度的颜色，并保护肤色。"
          }
