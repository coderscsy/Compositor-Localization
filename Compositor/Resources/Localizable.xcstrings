    "Use 1–%@ pixels per side, up to %lld megapixels, and 1–9,600 pixels/inch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie 1–%@ Pixel pro Seite, bis zu %lld Megapixel und 1–9.600 Pixel/Zoll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar 1– %@ píxeles por lado, hasta %lld megapíxeles y 1–9,600 píxeles/inch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 1– %@ pixels de chaque côté, jusqu'à %lld mégapixels et 1–9600 pixels/pouce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一辺は1〜%@ピクセル、全体は最大%lldメガピクセル、解像度は1〜9,600ピクセル/インチです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측면에 1~%@ 픽셀, 최대 %lld 메가 픽셀 및 1~9,600 픽셀/인치 사용."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边须为 1–%@ 像素，总像素数最多为 %lld 百万像素，分辨率须为 1–9,600 像素/英寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每邊須為 1–%@ 畫素，總畫素數最多為 %lld 百萬畫素，解析度須為 1–9,600 畫素/英寸。"
          }
        }
      }
    },
