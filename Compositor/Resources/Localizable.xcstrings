    "Blur only the colors, keeping the layer's outline and transparency as they are": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwischen Sie nur die Farben, wobei der Umriss und die Transparenz der Schicht so bleiben, wie sie sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfoque sólo los colores, manteniendo el contorno y la transparencia de la capa como son"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flou seulement les couleurs, en gardant le contour et la transparence du calque comme ils sont"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーの輪郭と透明度をそのままに、色だけをブラー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단지 색상만 빛나고, 그들이있는 방식으로 레이어의 출력과 투명성을 유지합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅模糊颜色，保留图层的轮廓和透明度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅模糊顏色，保留圖層的輪廓和透明度。"
          }
        }
      }
    },
