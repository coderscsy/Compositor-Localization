        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色をエッジにブレンドし、センターが変更されていないまま"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 색상을 옆구리로 혼합하여 중앙을 변함없이 유지합니다"
          }
        },
        "zh-Hans": {
