    "Only 8-bit RGB and CMYK Photoshop files can be imported.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur 8-Bit RGB und CMYK Photoshop Dateien können importiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se pueden importar archivos RGB de 8 bits y CMYK Photoshop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les fichiers RGB et CMYK Photoshop 8 bits peuvent être importés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8ビットRGBおよびCMYK Photoshopファイルのみをインポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8비트 RGB 및 CMYK Photoshop 파일만 수입할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能导入 8 位 RGB 和 CMYK Photoshop 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能匯入 8 位 RGB 和 CMYK Photoshop 檔案。"
          }
        }
      }
    },
    "Only print dimensions and resolution change. Pixels stay unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Druckabmessungen und Auflösung ändern sich. Pixel bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo las dimensiones de impresión y el cambio de resolución. Pixels se mantiene sin cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les dimensions d'impression et la résolution changent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷寸法と解像度の変更のみ。ピクセルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단지 인쇄 차원 및 해상도 변경. 픽셀은 변하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅调整打印尺寸和分辨率，像素数保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅調整列印尺寸和解析度，畫素數保持原樣。"
          }
        }
      }
    },
    "Only the first text style was kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der erste Textstil wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se mantuvo el primer estilo de texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le premier style de texte a été conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のテキストスタイルのみが保存されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단지 첫 번째 텍스트 스타일만 유지되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保留了第一种文字样式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅保留了第一種文字樣式。"
          }
        }
      }
    },
