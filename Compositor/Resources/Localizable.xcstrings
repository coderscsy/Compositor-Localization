          }
        }
      }
    },
    "How many times the picture echoes, each fainter": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像副本的数量，副本逐个变淡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影象副本的數量，副本逐個變淡。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de fois l'image résonne, chaque évanouissement"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft das Bild widerhallt, jeder schwächere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuantas veces se hace eco de la imagen, cada más débil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵のエコーの数回、各フェインター"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 자주 그림이 빛나는지, 각각의 빛"
          }
        }
      }
    },
    "How much colored speckle is smoothed into the colors around it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让彩色斑点融入周围颜色的程度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓彩色斑點融入周圍顏色的程度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de taches colorées est lissé dans les couleurs autour de lui"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel farbiges Speckle in die Farben um es herum geglättet wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánta especia de color se suaviza en los colores alrededor de ella"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周りの色に色がかった斑点が滑らかになる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 많은 색깔의 스펙트럼이 그것 주위의 색상에 녹는지"
          }
        }
      }
    },
    "How much fine texture and edges are kept while the grain is smoothed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降噪时保留细微纹理和边缘的程度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "降噪時保留細微紋理和邊緣的程度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de texture fine et les bords sont conservés pendant que le grain est lissé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel feine Textur und Kanten gehalten werden, während das Korn geglättet wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánta textura fina y los bordes se mantienen mientras el grano se suaviza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "粒が滑らかになる間どれだけの細かい質感とエッジが保持されるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 많은 얇은 구조와 가장자리가 곡물이 부드러워질 때 유지되는지"
          }
        }
      }
    },
    "How much grain is smoothed from the picture's brightness": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少图像亮度杂色的程度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少影象亮度雜色的程度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de grain est lissé de la luminosité de l'image"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Korn wird von der Helligkeit des Bildes geglättet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto grano se suaviza del brillo de la imagen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵の明るさからどれだけの粒が滑らかにされるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 많은 곡물이 그림의 밝기에서 부드러워지는지"
          }
        }
      }
    },
    "How much light scatters: a soft halo around bright areas, and gently lifted shadows": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制光线散射的程度，在亮部周围生成柔和光晕，并轻微提亮阴影。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制光線散射的程度，在亮部周圍生成柔和光暈，並輕微提亮陰影。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle quantité de lumière disperse: un halo doux autour des zones lumineuses, et doucement soulevé les ombres"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Licht streuet: ein weicher Halo um helle Bereiche und sanft angehobene Schatten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánta luz se dispersa: un halo suave alrededor de zonas brillantes, y sombras suavemente levantadas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのくらいの光が散らばる:明るいエリアの周りに柔らかいハロー、そして穏やかにシャドウを持ち上げました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 많은 빛의 스카트 : 밝은 지역 주위에 부드러운 홀, 그리고 부드럽게 올려진 그림자"
          }
        }
      }
    },
    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制像素量化误差向邻近像素扩散的程度。较低值会让色块更均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制畫素量化誤差向鄰近畫素擴散的程度。較低值會讓色塊更均勻。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de l'erreur de chaque pixel se propage à ses voisins. Moins donne des zones flattées"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel von jedem Pixelfehler breitet sich auf seine Nachbarn aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cantidad de errores de cada pixel se propaga a sus vecinos. Menos da áreas más planas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ピクセルの誤差が隣接する部分にどれだけ広がります。 少ないところは平坦な領域を与えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 픽셀의 오류가 얼마나 많은지 이웃에게 퍼집니다"
          }
        }
      }
    },
    "How much of the gap a bright line fills; dimmer parts draw it thinner": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明亮扫描线在行距中所占的比例，较暗部分的线条更细。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明亮掃描線在行距中所佔的比例，較暗部分的線條更細。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de l'écart une ligne lumineuse remplit; les parties variantes le dessinent plus finement"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel von der Lücke eine helle Linie füllt; dunklere Teile ziehen es dünner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánta distancia llena una línea brillante; las partes de martillo lo dibujan más delgada"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャップのどのくらい明るいラインが充填します。調光部品はそれを薄く引きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 많은 격차가 밝은 라인이 채우는지; 다이머 부품은 더 얇게 끌어 올립니다"
          }
        }
      }
    },
    "How much of the profile distortion correction is applied.": {
