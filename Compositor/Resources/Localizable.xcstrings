          }
        }
      }
    },
    "Hue around the wheel, saturation outward from the center. Control-click to show the histogram.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环绕色轮的角度表示色相，距中心的距离表示饱和度。按住 Control 键点按可显示直方图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環繞色輪的角度表示色相，距中心的距離表示飽和度。按住 Control 鍵點按可顯示直方圖。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courir autour de la roue, saturation vers l'extérieur du centre. Contrôlez-cliquez pour afficher l'histogramme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbton um das Rad, Sättigung von der Mitte nach außen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Huele alrededor de la rueda, saturación hacia fuera desde el centro. Control-clic para mostrar el histograma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイールの周りを Hue, 中心から外側に飽和. コントロールクリックしてヒストグラムを表示."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바퀴 주위에, 중앙에서 밖으로 만족. 컨트롤 클릭 이스트그램을 표시합니다."
          }
        }
      }
    },
