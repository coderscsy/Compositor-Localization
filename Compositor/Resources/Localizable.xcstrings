          }
        }
      }
    },
    "Blend the chosen color into the edges while keeping the center unchanged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选颜色混入边缘，保留中心原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所選顏色混入邊緣，保留中心原樣。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélanger la couleur choisie dans les bords tout en maintenant le centre inchangé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mischen Sie die gewählte Farbe in die Ränder, während Sie das Zentrum unverändert halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blend el color elegido en los bordes mientras mantiene el centro sin cambios"
          }
        },
        "ja": {
