    "The 2012 response. Calibration reaches most of the strength used by Version 6.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verarbeitung von 2012. Die Kalibrierung erreicht fast die Stärke von Version 6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesamiento de 2012. La calibración se aproxima a la intensidad de la versión 6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de 2012. L'étalonnage atteint la plus grande partie de la force utilisée par la version 6."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 応答。口径測定は版 6 で使用される強さのほとんどに達します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 응답: 칼리브레이션은 버전 6에서 사용되는 힘의 대부분을 달성합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 年的处理方式。校准强度已接近版本 6。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 年的處理方式。校準強度已接近版本 6。"
          }
        }
      }
    },
    "The Photoshop file could not be read. It may be damaged or incomplete.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Photoshop-Datei konnte nicht gelesen werden, sie kann beschädigt oder unvollständig sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de Photoshop no se puede leer. Puede ser dañado o incompleto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier Photoshop n'a pas pu être lu. Il peut être endommagé ou incomplet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Photoshopファイルが読み込まれない。破損や不完全な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Photoshop 파일은 읽을 수 없습니다.그것은 손상되거나 불완전 할 수 있습니다."
          }
        },
        "zh-Hans": {
