    "“%@” already exists. Replace it?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@ existiert bereits. Ersetzen Sie es?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“ %@ ” ya existe. Reemplazarlo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Il existe déjà. Remplacez-le ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は既に存在しています。置換しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은 이미 존재합니다.그것을 대체하십시오?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已存在。要替换吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已存在。要替換嗎？"
          }
        }
      }
    },
    "“%@” has no images to import.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”中没有可导入的图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」中沒有可匯入的影像。"
          }
        }
      }
    },
    "“%@” has nothing to export": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@ hat nichts zu exportieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“ %@ ” no tiene nada que exportar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Il n'y a rien à exporter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は輸出することができません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”는 수출 할 것이 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”没有可导出的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”沒有可匯出的內容"
          }
        }
      }
    },
    "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是文件夹，没有可直接绘制的像素。请在其中的图层或文件夹蒙版上绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是資料夾，沒有可直接繪製的像素。請在其中的圖層或資料夾遮色片上繪製。"
          }
        }
      }
    },
    "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是调整图层，没有可直接绘制的像素。请在其蒙版上绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是調整圖層，沒有可直接繪製的像素。請在其遮色片上繪製。"
          }
        }
      }
    },
    "“%@” is hidden, or inside a hidden folder. Show it to paint on it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已隐藏，或位于已隐藏的文件夹中。请先显示该图层，再进行绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已隱藏，或位於已隱藏的資料夾中。請先顯示該圖層，再進行繪製。"
          }
        }
      }
    },
    "“%@” is locked. Unlock it in the Layers panel to edit it.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is locked. Unlock it in the Layers panel to edit it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已锁定。请在图层面板中解锁后再编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已鎖定。請在圖層面板中解鎖後再編輯。"
          }
        }
      }
    },
