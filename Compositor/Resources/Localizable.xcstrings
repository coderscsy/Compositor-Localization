    "The boolean operation produced an empty shape.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The boolean operation produced an empty shape."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布尔运算结果为空形状。"
          }
        },
