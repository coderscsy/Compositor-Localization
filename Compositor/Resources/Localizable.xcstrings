    "Darkens or lightens the edges. The center does not change.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdunkelt oder hellt die Kanten auf. Die Mitte ändert sich nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece o enciende los bordes. El centro no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombre ou allège les bords. Le centre ne change pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端を暗くするか、または軽減して下さい。中心は変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두워지거나 가장자리를 밝게합니다.중앙은 변하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调暗或调亮边缘，保留中心原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調暗或調亮邊緣，保留中心原樣。"
          }
        }
      }
    },
