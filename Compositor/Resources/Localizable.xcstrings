    "A layer with no visible pixels, such as an adjustment layer, isn’t saved as a PNG.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Schicht ohne sichtbare Pixel, z. B. eine Anpassungsschicht, wird nicht als PNG gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una capa sin píxeles visibles, como una capa de ajuste, no se guarda como un PNG."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un calque sans pixels visibles, comme un calque de réglage, n'est pas enregistré comme PNG."
          }
