    "Lock aspect ratio. Hold Shift while dragging a handle to turn it the other way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitenverhältnis Sperren. Schalten Sie den Schalter, während Sie einen Griff ziehen, um ihn in die andere Richtung zu drehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque la relación de aspecto. Sostenga el Shift mientras arrastra una manija para girar por el otro lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillez le rapport d'aspect. Maintenez Maj tout en faisant glisser une poignée pour la tourner de l'autre manière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アスペクト比をロックします。 ハンドルをドラッグしながらシフトを押しながら、他の方法で回転させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기 측면 비율. 한 손잡이를 끌고 다른 방향으로 돌리면서 Shift를 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定宽高比。拖动控制点时按住 Shift 可临时切换锁定状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定寬高比。拖動控制點時按住 Shift 可臨時切換鎖定狀態。"
          }
        }
      }
    },
