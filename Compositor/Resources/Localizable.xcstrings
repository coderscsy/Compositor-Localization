    "Hide the background behind a layer mask, keeping the foreground subjects. The pixels stay, so the background can be painted back at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstecken Sie den Hintergrund hinter einer Schichtmaske, behalten Sie die Vordergrundmotive. Die Pixel bleiben, so dass der Hintergrund jederzeit zurückgemalt werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar el fondo detrás de una máscara de capa, manteniendo los temas del primer plano. Los píxeles se quedan, por lo que el fondo puede ser pintado de nuevo en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cacher l'arrière-plan derrière un masque de calque, en gardant les sujets au premier plan. Les pixels restent, de sorte que l'arrière-plan peut être peint à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーマスクの背後にある背景を隠すと、フォアグラウンドの被写体を保持します。ピクセルは保持しているため、いつでも背景をペイントすることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 레이어 마스크 뒤에 배경을 숨기고, 이미지 개체의 전면을 유지합니다. 픽셀은 남아 있으므로 배경은 언제든지 다시 그릴 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用图层蒙版隐藏背景并保留前景主体。原始像素会保留，随时可以在蒙版上涂绘以恢复背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用圖層遮色片隱藏背景並保留前景主體。原始畫素會保留，隨時可以在遮色片上塗繪以恢復背景。"
          }
        }
      }
    },
