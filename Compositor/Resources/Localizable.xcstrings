    "Shifts how green is interpreted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verändert, wie grün interpretiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de lo verde que se interpreta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace la façon dont le vert est interprété."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑が解釈されるシフト。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹색이 어떻게 해석되는지 바꾸는 방법."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
