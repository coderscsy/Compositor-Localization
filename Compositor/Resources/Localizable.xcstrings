            "value": "拖動柔化"
          }
        }
      }
    },
    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie nach oben oder unten, um diese Töne anzuheben oder abzusenken. Ziehen Sie einen Trenner entlang der Unterseite, um zu ändern, welche Töne jede Region abdeckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre hacia arriba o hacia abajo para levantar o bajar los tonos. Arrastre un divider a lo largo de la parte inferior para cambiar qué tonos cubre cada región."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser vers le haut ou vers le bas pour soulever ou abaisser ces tons. Faites glisser un diviseur le long du fond pour changer les tons que chaque région couvre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それらのトーンを持ち上げるか、または下げるために上下にドラッグします。各領域がカバーするトーンを変更するには、下部に沿ってディバイダーをドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 톤을 올리거나 낮추기 위해 위로 또는 아래로 끌어내십시오. 각 지역이 커버하는 톤을 변경하기 위해 바닥을 따라 분할기를 끌어내십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下拖动以调亮或调暗对应的色调。沿底部拖动分隔线以调整各区域覆盖的色调范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下拖動以調亮或調暗對應的色調。沿底部拖動分隔線以調整各區域覆蓋的色調範圍。"
          }
        }
      }
    },
    "Draw Guides": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnungsführer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guías de dibujo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiner des guides"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドローガイド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안내선 그리기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制参考线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製參考線"
          }
        }
      }
    },
    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnen Sie jedes stückige Pixel als ein festes Quadrat oder als einen runden Punkt wie einen Punktmatrixbildschirm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja cada píxel chunky como un cuadrado sólido, o como un punto redondo como una pantalla de punto-matrix"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiner chaque pixel en morceaux comme un carré solide, ou comme un point rond comme un écran de matrix"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各chunkyピクセルをソリッドスクエアとして描画するか、ドットマトリクス画面のような丸い点として描画します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 chunky 픽셀을 단단한 평방으로 또는 포트 매트릭스 스크린과 같은 둥근 점으로 그리십시오"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个大像素绘制为实心方块或点阵屏幕效果的圆点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將每個大畫素繪製為實心方塊或點陣螢幕效果的圓點。"
          }
        }
      }
    },
    "Draw no line where the picture is darker than this, leaving the screen dark": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnen Sie keine Linie, bei der das Bild dunkler ist als dies, und lassen Sie den Bildschirm dunkel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No dibuje ninguna línea donde la imagen es más oscura que esta, dejando la pantalla oscura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne dessinez pas de ligne où l'image est plus sombre que cela, laissant l'écran sombre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を暗くする線を描画しないで"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림이 이것보다 어두운 곳에 라인을 그리지 않고 화면을 어둡게합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于此亮度的区域保留屏幕底色，不绘制扫描线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於此亮度的區域保留螢幕底色，不繪製掃描線。"
          }
        }
      }
    },
    "Draw the marks for the light tones on the dark color, like a glowing screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne die Markierungen für die hellen Töne auf der dunklen Farbe, wie ein leuchtender Bildschirm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja las marcas para los tonos de luz en el color oscuro, como una pantalla brillante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez les marques pour les tons de lumière sur la couleur foncée, comme un écran lumineux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗い色のライトトーンのマークを描画します。, 輝く画面のように"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 색상에 빛의 톤을위한 표지판을 그리십시오, 빛나는 스크린처럼"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色底上绘制亮调的图样，模拟发光屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色底上繪製亮調的圖樣，模擬發光螢幕。"
          }
        }
      }
    },
    "Draw two or more lines on the preview that should be level or vertical.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnen Sie zwei oder mehr Linien in der Vorschau, die eben oder vertikal sein sollten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibujar dos o más líneas en la vista previa que debe ser nivel o vertical."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez deux ou plusieurs lignes sur l'aperçu qui devraient être planes ou verticales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベルまたは垂直であるべきプレビューの2つ以上の行を描画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에서 수평 또는 수직이 되어야 할 선을 두 개 이상 그리세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览中沿应当水平或垂直的边缘绘制至少两条参考线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在預覽中沿應當水平或垂直的邊緣繪製至少兩條參考線。"
          }
        }
      }
    },
