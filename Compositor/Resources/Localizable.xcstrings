    "How far into the scene the haze begins: low reaches up to the camera, high leaves all but the farthest parts clear": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit in die Szene der Dunst beginnt: niedrig reicht bis zur Kamera, hoch lässt alle bis auf die entferntesten Teile klar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuán lejos en la escena comienza la escobilla: baja llega hasta la cámara, alta deja todo menos las partes más lejanas claras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'où commence la brume dans la scène : bas atteint la caméra, haut laisse toutes les parties sauf les plus lointaines claires"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘイズが始まるシーンまで:カメラ、高い葉まで到達するが、最も遠い部分はクリア"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 멀리 무대에  ⁇ 이 시작됩니다 : 낮은 카메라에 도달하고, 높은 모든 것을 떠나지만 가장 멀리 떨어진 부분은 분명합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雾效开始显现的深度。低值让雾气延伸至相机附近，高值仅在最远处保留雾气。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "霧效開始顯現的深度。低值讓霧氣延伸至相機附近，高值僅在最遠處保留霧氣。"
          }
        }
      }
    },
    "How far out of focus: the size of each disc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit aus dem Fokus: die Größe jeder Disc"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuán lejos de foco: el tamaño de cada disco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'où est hors de la focalisation : la taille de chaque disque"
