            "state": "translated",
            "value": "改變綠原色的色相。"
          }
        }
      }
    },
    "Shifts how red is interpreted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verändert, wie rot interpretiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cambia cómo se interpreta el rojo."
          }
        },
        "fr": {
          "stringUnit": {
