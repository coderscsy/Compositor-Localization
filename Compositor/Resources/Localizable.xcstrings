    "Darkens or lightens the edges. The center does not change.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调暗或调亮边缘，保留中心原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調暗或調亮邊緣，保留中心原樣。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombre ou allège les bords. Le centre ne change pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdunkelt oder hellt die Kanten auf. Die Mitte ändert sich nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece o enciende los bordes. El centro no cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端を暗くするか、または軽減して下さい。中心は変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두워지거나 가장자리를 밝게합니다.중앙은 변하지 않습니다."
          }
        }
      }
    },
    "Darker or lighter before the lines are drawn": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制扫描线前调暗或调亮图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製掃描線前調暗或調亮影象。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus foncé ou plus léger avant que les lignes ne soient tracées"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkler oder heller, bevor die Linien gezeichnet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más oscuro o más ligero antes de que las líneas se dibujan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線が引かれる前に暗いかより軽いです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라인이 끌려오기 전에 더 어둡거나 가벼운"
          }
        }
      }
    },
