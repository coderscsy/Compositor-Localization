          }
        }
      }
    },
    "Select layers by clicking the canvas. Hold Command to turn it the other way while you click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Ebenen aus, indem Sie auf die Leinwand klicken. Halten Sie den Befehl, um sie in die andere Richtung zu drehen, während Sie klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione capas haciendo clic en el lienzo. Sostenga comando para girarlo de la otra manera mientras hace clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez les calques en cliquant sur la toile. Maintenez la commande pour la tourner de l'autre manière pendant que vous cliquez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするとレイヤーを選択します。コマンドを実行して、クリック中に他の方法を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스를 클릭하여 레이어를 선택하십시오.Command를 유지하여 클릭하는 동안 다른 방향으로 회전합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按画布即可选择图层。按住 Command 点按可暂时反转此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按畫布即可選擇圖層。按住 Command 點按可暫時反轉此設定。"
          }
        }
      }
    },
