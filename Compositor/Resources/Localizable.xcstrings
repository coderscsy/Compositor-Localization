    "Off leaves the picture as it is. Guided straightens from lines you draw on the picture.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「关闭」保留图像原样。「引导」根据你在图像上绘制的参考线拉直图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「關閉」保留影象原樣。「引導」根據你在影象上繪製的參考線拉直影象。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout en laissant l'image comme elle est. Guidé par des lignes que vous dessinez sur l'image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus lässt das Bild so, wie es ist. Geführt streckt sich aus Linien, die Sie auf dem Bild zeichnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera deja la imagen como es. Enderezados guiados de líneas que dibujan en la imagen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をそのまま残します。写真に描いている線からまっすぐにガイドをつけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 그대로 남아있다.그림에 그려진 라인에서 직접 지시."
          }
        }
      }
    },
