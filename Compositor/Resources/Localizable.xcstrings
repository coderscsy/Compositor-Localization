    "Blend mode “%@” isn’t supported and will be applied as Normal.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "混合模式“%@”暂不受支持，已改为正常模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "混合模式“%@”暫不受支援，已改為正常模式。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode de mélange - %@ - est supporté et sera appliqué comme normal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Blend-Modus \"%@\" wird nicht unterstützt und wird als Normal angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo Blend “ %@ ” no es compatible y se aplicará como Normal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレンドモード「%@」はサポートされていません。"
