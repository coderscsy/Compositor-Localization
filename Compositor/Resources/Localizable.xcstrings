        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 멀리 색상이 선택된 색상과 여전히 선택될 수 있는지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可被选中的颜色与拾取颜色之间允许的最大差异"
