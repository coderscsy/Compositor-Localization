    "Cropped to the canvas so the file fits in memory. Pixels outside the canvas weren't imported.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Leinwand gehackt, damit die Datei in den Speicher passt. Pixel außerhalb der Leinwand wurden nicht importiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cropped a la tela para que el archivo se ajuste en memoria. Pixels fuera del lienzo no fueron importados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Replanté sur la toile de sorte que le fichier s'adapte en mémoire. Pixels à l'extérieur de la toile n'ont pas été importés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスに刻まれたので、ファイルがメモリに収まります。 キャンバスの外側のピクセルはインポートされていませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스에 붙여서 파일이 메모리에 맞게 됩니다. 캔버스 밖의 픽셀은 수입되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为降低内存占用，已裁切至画布范围。画布外像素已跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為降低記憶體佔用，已裁切至畫布範圍。畫布外畫素已跳過。"
          }
        }
      }
    },
    "Crops empty edges after the transform and fits the result back into the frame.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt leere Kanten nach der Transformation und passt das Ergebnis wieder in den Rahmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiva los bordes vacíos después de la transformación y se ajusta al resultado de nuevo en el marco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crops bords vides après la transformation et adapte le résultat à nouveau dans le cadre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換後の空のエッジをクロップし、結果がフレームに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환 후 빈 가장자리를 자르고 결과를 다시 프레임에 맞추십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裁剪变换后留下的空白边缘，并将结果缩放至原来的画幅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裁剪變換後留下的空白邊緣，並將結果縮放至原來的畫幅。"
          }
        }
      }
    },
