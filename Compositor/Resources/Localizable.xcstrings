          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience a ver-a través, o con una capa de fondo blanca o negra. Haga clic para cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par voir à travers, ou avec une couche de fond blanche ou noire. Cliquez pour basculer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明な状態から始めるか、白または黒の背景レイヤーを追加します。クリックで切り替えます。"
