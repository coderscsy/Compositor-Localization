            "value": "Ziehen Sie, um Farbton und Sättigung einzustellen. Doppelklicken Sie, um dieses Rad zurückzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre para establecer el casco y la saturación. Haga doble clic para restablecer esta rueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour définir la teinte et la saturation. Double-cliquez pour remettre cette roue à zéro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hueと飽和を設定するためにドラッグします。このホイールをリセットするにはダブルクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 바퀴를 다시 설정하려면 두 번 클릭합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以设置色相和饱和度，连按两下可重置此色轮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動以設定色相和飽和度，連按兩下可重置此色輪。"
          }
        }
      }
    },
    "Drag to sharpen": {
