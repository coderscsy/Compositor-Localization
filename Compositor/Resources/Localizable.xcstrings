    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先增强低饱和度的颜色，并保护肤色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先增強低飽和度的顏色，並保護膚色。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforce les couleurs silencieuses plus que les couleurs qui sont déjà fortes, et protège les tons de peau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stärkt ruhige Farben mehr als Farben, die bereits stark sind, und schützt Hauttöne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece los colores silenciosos más que los colores que ya son fuertes, y protege los tonos de la piel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既に強い色よりも静的な色を強くし、肌のトーンを保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강점은 이미 강한 색상보다 조용한 색상을 더 강화하고 피부 톤을 보호합니다."
          }
        }
      }
    },
