          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque de serrage basé sur %@ . Option-cliquez sur le bas de sa ligne pour la libérer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に基づくクリッピングマスク。オプションは、その行の下部をクリックしてリリースします。"
          }
