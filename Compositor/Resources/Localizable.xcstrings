    "Preserve hue and avoid clipping colors while dodging or burning": {},
    "Preserves colored edges while color noise is reduced.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahrt farbige Kanten, während das Farbrauschen reduziert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva los bordes coloreados mientras el ruido de color se reduce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préserve les bords colorés tandis que le bruit de couleur est réduit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色のノイズを抑えながら色落ちしたエッジを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상 이미지 소음이 감소하는 동안 색상 경계를 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少彩色杂色时保留颜色边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少彩色雜色時保留顏色邊緣。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konserviert feine Textur, während das Luminanzrauschen reduziert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva una textura fina mientras se reduce el ruido de luminancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préserve la texture fine tandis que le bruit de luminance est réduit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発光ノイズを抑えながら、細かいテクスチャーを維持。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛의 이미지 소음이 줄어든 동안 얇은 구조를 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少明亮度杂色时保留细微纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少明亮度雜色時保留細微紋理。"
          }
        }
      }
    },
