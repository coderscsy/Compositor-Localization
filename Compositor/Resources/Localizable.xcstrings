    "Keep Mine": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留当前版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留當前版本"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le mien"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mine aufbewahren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la mía"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鉱山を保って下さい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나를 지켜라"
          }
        }
      }
    },
    "Keep Subject Clear": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持主体清晰"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持主體清晰"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le sujet clair"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte das Thema klar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga el asunto claro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注意: クリア"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피사체에 안개 적용 안 함"
          }
        }
      }
    },
    "Keep the 16-bit layers' full precision, in a file about twice the size": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 16 位图层的完整精度，文件大小约为两倍"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 16 點陣圖層的完整精度，檔案大小約為兩倍"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la précision des couches 16 bits, dans un fichier environ deux fois la taille"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die volle Präzision der 16-Bit-Schichten in einer Datei, die etwa doppelt so groß ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la precisión completa de las capas de 16 bits, en un archivo alrededor del doble del tamaño"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約 2 倍のファイルサイズで 16 ビットレイヤーの精度を維持"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "16비트 레이어의 완전한 정확도를 유지하십시오, 파일 크기의 약 두 배"
          }
        }
      }
    },
    "Keep the source moving with the brush between strokes; off starts every stroke at the source point": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持取样位置与画笔同步移动；关闭后，每笔都从原取样点开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持取樣位置與畫筆同步移動；關閉後，每筆都從原取樣點開始"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la source en mouvement avec le pinceau entre les coups; désactivez chaque coup au point de départ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Quelle mit der Bürste zwischen den Strichen bewegen; off beginnt jeden Strich an der Quelle Punkt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la fuente moviéndose con el pincel entre golpes; apagado comienza cada golpe en el punto de origen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストローク間のブラシでソースの移動を保って下さい;オフは源のポイントですべての打撃を始めます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공격 사이의 브러시와 함께 출처를 움직이게하십시오; 출처 지점에서 모든 공격이 시작됩니다"
          }
        }
      }
    },
    "Keep the subject clear of the haze; off, it's hazed by its own distance, so a figure far off is misted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后主体不受雾效影响。关闭后按主体深度计算雾效，远处主体也会被雾气覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後主體不受霧效影響。關閉後按主體深度計算霧效，遠處主體也會被霧氣覆蓋。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le sujet à l'écart de la brume; hors, il est rasé par sa propre distance, donc un chiffre loin est mis au brouillard"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie das Motiv frei von dem Dunst; aus, es wird durch seine eigene Entfernung betäubt, so dass eine weit entfernte Figur vernebelt ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga el tema claro de la escobilla; fuera, está novatada por su propia distancia, por lo que una cifra muy lejos se malinterpreta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘイズの被写体をクリアに保って下さい;オフ、それはそれ自身の距離によって傷つけられます、従って遠く離れた図は霧化されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제가  ⁇ 에서 깨끗하게 유지하십시오; 밖으로, 그것은 자신의 거리로  ⁇ 되어 있으므로 멀리 떨어진 그림이 틀린다"
          }
        }
      }
    },
    "Keep transparent areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留透明区域"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留透明區域"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les zones transparentes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparente Bereiche beibehalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar las zonas transparentes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明なエリアを保ちましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투명한 영역을 유지"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在平滑明亮度后保留局部对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在平滑明亮度後保留區域性對比度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le contraste local après lissage de la luminance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält den lokalen Kontrast nach der Glättung der Luminanz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el contraste local después de suavizar la luminancia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発光の滑らかさの後でローカル コントラストを保って下さい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛의 부드러움 후에 현지 대조를 키프."
          }
        }
      }
    },
    "Keeps this point fixed. Artwork is not scaled; cropped content remains outside the canvas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定此定位点。图像保持原尺寸，裁掉的内容保留在画布外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定此定位點。影象保持原尺寸，裁掉的內容保留在畫布外。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'artwork n'est pas étalonné; le contenu recadré reste en dehors de la toile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kunstwerk wird nicht skaliert, der beschnittene Inhalt bleibt außerhalb der Leinwand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene este punto fijo. El arte no es escalado; el contenido recortado permanece fuera del lienzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この点を固定します。 アートワークはスケールアウトされません。 作物のコンテンツはキャンバスの外に残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예술 작품은 스케일되지 않습니다; 녹은 콘텐츠는 캔버스 밖으로 남아 있습니다."
          }
        }
      }
    },
