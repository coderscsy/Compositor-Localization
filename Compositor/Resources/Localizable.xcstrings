          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le point le plus sombre. Maintenez l'option pour voir les ombres coupées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt den dunkelsten Punkt. Halten Option, um beschnittene Schatten zu sehen."
          }
        },
        "es": {
