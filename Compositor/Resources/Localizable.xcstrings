          "stringUnit": {
            "state": "translated",
            "value": "印刷業者から提供されたものなど、CMYK ICCプロファイルを使用します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CMYK ICC 프로필을 사용하십시오, 예를 들어 프린터가 제공 한 것과 같습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 CMYK ICC 配置文件，例如印刷服务商提供的文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 CMYK ICC 配置檔案，例如印刷服務商提供的檔案"
          }
        }
      }
    },
    "Use gridlines every %lld–%@ pixels and %lld–%lld subdivisions, no more than the pixels between gridlines.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Rasterlinien alle %lld-%@-Pixel und %lld-%lld-Unterteilungen, nicht mehr als die Pixel zwischen den Rasterlinien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice rejillas cada %lld – %@ pixels y %lld – %lld subdivisiones, no más que los píxeles entre rejillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les lignes de grilles toutes les subdivisions %lld – %@ pixels et %lld – %lld, pas plus que les pixels entre les lignes de grille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld – %@ ピクセルと %lld - %lld サブディビジョンごとにグリッドラインを使用して、グリッド線間のピクセル以上は使用しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 %lld - %@ 픽셀 및 %lld - %lld 하위 부서를 사용하십시오, 그 사이의 픽셀을 초과하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格线间距须为 %lld–%@ 像素。子网格数须为 %lld–%lld，且不能超过网格线之间的像素数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網格線間距須為 %lld–%@ 畫素。子網格數須為 %lld–%lld，且不能超過網格線之間的畫素數。"
          }
        }
      }
    },
    "Use smooth squircle corners at 60% smoothing, matching Figma's iOS setting": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie glatte Eichhörnchen-Ecken bei 60% Glättung, passend zu Figmas iOS-Einstellung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice esquinas suaves del squircle al 60% suavizar, ajuste de Figma iOS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser des coins squircles lisses à 60%, en fonction du réglage iOS de Figma"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma の iOS の設定にマッチする、60% のスムージングで滑らかな小角を使用して下さい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma의 iOS 설정과 일치하는 60 % 부드러움에서 부드러운 둥근 구석을 사용하십시오"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用平滑度为 60% 的圆角，与 Figma 的 iOS 设置一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用平滑度為 60% 的圓角，與 Figma 的 iOS 設定一致"
          }
        }
      }
    },
    "Use the Pen tool (P) to draw Bézier paths, or convert a selection to a path.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Pen tool (P) to draw Bézier paths, or convert a selection to a path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用钢笔工具 (P) 绘制贝塞尔路径，或从当前选区生成路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用鋼筆工具 (P) 繪製貝茲路徑，或從目前選取範圍建立路徑。"
          }
        }
      }
    },
