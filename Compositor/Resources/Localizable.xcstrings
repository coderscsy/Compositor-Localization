    "Adjusts the bright parts of the picture. Hold Option to see clipped highlights.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt die hellen Teile des Bildes an. Halten Sie die Option, um abgeschnittene Highlights zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste las partes brillantes de la imagen. Sostenga la opción para ver recortadas resaltas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste les parties lumineuses de l'image. Maintenez l'option pour voir les points forts clippés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の明るい部分を調節します。 クリップされたハイライトを表示するオプションを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림의 밝은 부분을 조정합니다. 옵션을 유지하여 클립 된 히틀러를 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整图像的明亮部分。按住 Option 键可查看高光剪切。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整影象的明亮部分。按住 Option 鍵可檢視高光剪下。"
          }
        }
      }
    },
    "Adjusts the dark parts of the picture. Hold Option to see clipped shadows.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt die dunklen Teile des Bildes ein. Halten Sie die Option, um abgeschnittene Schatten zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
