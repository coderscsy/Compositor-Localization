        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que la familia de color seleccionada sea más clara o más oscura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre la famille de couleurs sélectionnée plus claire ou plus foncée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された色の家族のライターかより暗い作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 색상 가족을 더 밝거나 어두워집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
