    "Quit and reopen Compositor to apply the language change.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende Compositor und öffne die App erneut, um die Sprache zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra y vuelve a abrir Compositor para aplicar el cambio de idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez et rouvrez Compositor pour appliquer la nouvelle langue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の変更を適用するには、Compositorを終了して開き直してください。"
          }
        },
        "ko": {
