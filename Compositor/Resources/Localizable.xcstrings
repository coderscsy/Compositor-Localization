    "Linear blurs along the line; Radial keeps the start sharp and blurs outwards": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「线性」沿直线模糊，「径向」保持起点清晰并向外模糊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「線性」沿直線模糊，「徑向」保持起點清晰並向外模糊。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flous linéaires le long de la ligne; Radial maintient le départ net et se brouille vers l'extérieur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineare Unschärfen entlang der Linie; Radial hält den Start scharf und verwischt nach außen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Difuminados lineales a lo largo de la línea; Radial mantiene el inicio agudo y se borre hacia fuera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線に沿ってリニアブラー。放射状は、スタートを鋭く保ち、外側に膨らむ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라인은 라인을 따라 흐르며, 라디얼은 시작을 날카롭게 유지하고 외부로 흐른다"
          }
        }
      }
    },
