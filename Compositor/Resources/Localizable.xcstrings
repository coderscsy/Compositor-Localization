    "Auto balances the average color. Custom follows Temperature and Tint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「自动」根据平均颜色校正白平衡。「自定」使用色温和色调的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」根據平均顏色校正白平衡。「自定」使用色溫和色調的設定。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto équilibre la couleur moyenne. Personnalisé suit Température et teinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto gleicht die durchschnittliche Farbe aus. Custom folgt Temperatur und Tönung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto equilibra el color promedio. Personalizado sigue Temperatura y Tinta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動は平均色のバランスをとります。習慣は温度および色合いに続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 평균 색상을 균형 잡습니다.Custom은 온도와 색조를 따릅니다."
          }
        }
      }
    },
