            "value": "Verändert, wie grün interpretiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de lo verde que se interpreta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑が解釈されるシフト。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹색이 어떻게 해석되는지 바꾸는 방법."
          }
        }
      }
    },
    "Shifts how red is interpreted.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变红原色的色相。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變紅原色的色相。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
