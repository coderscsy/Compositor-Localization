    "Earliest response. Hue, saturation, and shadow tint move about half as far as Version 6.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die früheste Antwort. Farbton, Sättigung und Schattentöne bewegen sich etwa halb so weit wie Version 6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta más temprana. Hueso, saturación y tinte de sombra se mueven alrededor de la mitad hasta la versión 6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plus haute réponse. La teinte de la nuée, de la saturation et de l'ombre se déplacent environ la moitié jusqu'à la version 6."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早い応答。 Hue、飽和、影の色合いは、バージョン6まで約半分に動く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 초기 응답: 껍질, 만족 및 그림자 색조는 버전 6까지 약 절반으로 이동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最早的处理方式。色相、饱和度和阴影色调的调整幅度约为版本 6 的一半。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最早的處理方式。色相、飽和度和陰影色調的調整幅度約為版本 6 的一半。"
          }
        }
      }
    },
