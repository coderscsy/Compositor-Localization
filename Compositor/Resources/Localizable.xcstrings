    "Where the light comes from, behind the subject: 0° from the right, 90° from above": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光源在主体后方照射的方向。0° 从右侧照入，90° 从上方照入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光源在主體後方照射的方向。0° 從右側照入，90° 從上方照入。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'où vient la lumière, derrière le sujet: 0° de la droite, 90° d'en haut"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woher das Licht kommt, hinter dem Motiv: 0° von rechts, 90° von oben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De donde viene la luz, detrás del tema: 0° de la derecha, 90° desde arriba"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "被写体から光が来る場所:右から0°、上から90°"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛이 어디에서 오는지, 주제 뒤에 : 0° 오른쪽에서, 90° 위에서"
          }
        }
      }
    },
    "Which way the colors spread": {
      "localizations": {
        "zh-Hans": {
