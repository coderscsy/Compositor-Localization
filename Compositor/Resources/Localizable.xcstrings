    "Adds film grain, strongest in the middle tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，中间调的颗粒最明显。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增膠片顆粒，中間調的顆粒最明顯。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute du grain de film, le plus fort dans les tons du milieu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Filmkorn hinzu, am stärksten in den Mitteltönen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade grano de película, más fuerte en los tonos medio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルムの穀物を、中間の調子で最も強い加えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화 곡물, 중간 톤에서 가장 강한 추가."
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为最暗的色调添加绿色或洋红色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為最暗的色調新增綠色或洋紅色。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter le vert ou le magenta aux tons les plus foncés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Grün oder Magenta zu den dunkelsten Tönen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade verde o magenta a los tonos más oscuros."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑またはマゼンタを最も暗い色調に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 어두운 톤에 녹색 또는 마겐타를 추가합니다."
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱较大轮廓的对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強或減弱較大輪廓的對比度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ou adoucit le contraste sur des formes plus larges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt hinzu oder weicht den Kontrast entlang breiterer Formen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o suaviza el contraste a lo largo de formas más amplias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より広い形状に沿ってコントラストを追加または柔らかくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넓은 모양을 따라 대조 또는 부드러움."
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化细微纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強或柔化細微紋理。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ou adoucit de petits détails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänzt oder erweicht kleine Details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o suaviza pequeños detalles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "細かい部分を小さくしたり、柔らかくしたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 세부 사항을 추가하거나 부드럽게합니다."
          }
        }
      }
    },
    "Adjustment parameters may not match Photoshop exactly.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整参数可能与 Photoshop 存在差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整引數可能與 Photoshop 存在差異。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres de réglage peuvent ne pas correspondre exactement à Photoshop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anpassungsparameter stimmen möglicherweise nicht genau mit Photoshop überein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los parámetros de ajuste pueden no coincidir con Photoshop exactamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調整パラメータは、Photoshopに正確に一致しない場合があります。"
