    "Shrink the mask to drop the rim of background color around the subject, or grow it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收缩蒙版以去除主体边缘残留的背景色，或扩展蒙版边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收縮遮色片以去除主體邊緣殘留的背景色，或擴充套件遮色片邊緣。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
