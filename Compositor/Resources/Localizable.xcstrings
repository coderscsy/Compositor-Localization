    "Text-editing shortcuts need Command, Option, or Control so they do not replace normal typing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textbearbeitungs-Verknüpfungen benötigen Befehl, Option oder Steuerung, damit sie die normale Eingabe nicht ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de edición de texto necesitan Comando, Opción o Control para que no sustituyan la escritura normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis d'édition de texte ont besoin de commande, d'option ou de contrôle afin qu'ils ne remplacent pas la saisie normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト編集のショートカットは、コマンド、オプション、またはコントロールを必要としているので、通常のタイピングを置き換えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 편집 단축은 명령, 옵션 또는 컨트롤이 필요하므로 정상 인쇄를 대체하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字编辑快捷键须搭配 Command、Option 或 Control，避免影响正常输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字編輯快捷鍵須搭配 Command、Option 或 Control，避免影響正常輸入。"
          }
        }
      }
    },
