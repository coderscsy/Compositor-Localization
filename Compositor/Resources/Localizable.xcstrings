    "Round the rectangle's corners by this many pixels; 0 keeps them square": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Ecken des Rechtecks um so viele Pixel; 0 hält sie quadratisch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redondear las esquinas del rectángulo por estos muchos píxeles; 0 los mantiene cuadrados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourner les coins du rectangle par ces nombreux pixels ; 0 les garde carrées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この多くのピクセルで長方形の角を丸め、0はそれらを正方形に保ちます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 수많은 픽셀로 직경의 각도를 회전하십시오; 0은 평방을 유지합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将矩形的圆角半径设为指定像素数；0 表示直角"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將矩形的圓角半徑設為指定畫素數；0 表示直角"
          }
        }
      }
    },
