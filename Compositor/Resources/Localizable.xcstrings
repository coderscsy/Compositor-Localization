    "Smooth edges; turn off for hard pixel edges, like a pencil": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑边缘；关闭可获得类似铅笔工具的硬边像素效果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑邊緣；關閉可獲得類似鉛筆工具的硬邊畫素效果"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arêtes lisses; éteignez pour les bords du pixel dur, comme un crayon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glatte Kanten; Schalten Sie für harte Pixelkanten aus, wie ein Bleistift"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aristas suaves; apague para los bordes de píxeles duros, como un lápiz"
