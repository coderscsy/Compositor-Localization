        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "形狀過大。單一形狀最多可覆蓋 %lld 百萬像素。"
          }
        }
      }
    },
    "That text box exceeds the %@-pixel or %lld-megapixel limit.": {
